<style>
  .sub-tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin: 0 0 2rem; padding-bottom: 1rem; border-bottom: 1px solid var(--global-divider-color); }
  .sub-tabs a { padding: 0.45rem 1rem; border-radius: 999px; border: 1px solid var(--global-divider-color); font-size: 0.95rem; font-weight: 600; color: var(--global-text-color) !important; text-decoration: none !important; }
  .sub-tabs a:hover { border-color: var(--global-theme-color); }
  .sub-tabs a.active { background: var(--global-theme-color); border-color: var(--global-theme-color); color: #fff !important; }
  .term-grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); margin-bottom: 2.2rem; }
  .term-card { border: 1px solid var(--global-divider-color); border-radius: 16px; padding: 1.2rem 1.3rem; background: var(--global-card-bg-color); }
  .term-card h3 { display: flex; justify-content: space-between; align-items: baseline; font-size: 1.05rem; font-weight: 700; margin: 0 0 0.7rem; }
  .term-card h3 small { font-size: 0.8rem; font-weight: 600; color: var(--global-text-color-light); }
  .term-card ul { list-style: none; margin: 0; padding: 0; }
  .term-card li { display: flex; justify-content: space-between; align-items: baseline; gap: 0.6rem; padding: 0.42rem 0; border-top: 1px solid var(--global-divider-color); font-size: 0.95rem; }
  .term-card li > span:first-child { flex: 1 1 auto; min-width: 0; }
  .term-card li span.ko { display: block; font-size: 0.8rem; color: var(--global-text-color-light); }
  .term-card li span.cr { flex: none; color: var(--global-text-color-light); font-variant-numeric: tabular-nums; }
  h2.year-label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--global-text-color-light); margin: 0 0 1rem; }
  .sub-posts { list-style: none; margin: 1rem 0 0; padding: 0; border-top: 1px solid var(--global-divider-color); }
  .sub-posts li { display: flex; gap: 1rem; align-items: baseline; padding: 0.8rem 0; border-bottom: 1px solid var(--global-divider-color); }
  .sub-posts time { flex: none; width: 6.5rem; font-size: 0.85rem; color: var(--global-text-color-light); font-variant-numeric: tabular-nums; }
  .sub-empty { color: var(--global-text-color-light); }
</style>
<nav class="sub-tabs" aria-label="B.S. sections">
  <a href="{{ '/bs/' | relative_url }}" {% if include.active == 'overview' %}class="active"{% endif %}>Overview</a>
  <a href="{{ '/bs/courses/' | relative_url }}" {% if include.active == 'courses' %}class="active"{% endif %}>Courses</a>
  <a href="{{ '/bs/lab/' | relative_url }}" {% if include.active == 'lab' %}class="active"{% endif %}>Lab</a>
  <a href="{{ '/bs/club/' | relative_url }}" {% if include.active == 'club' %}class="active"{% endif %}>Club</a>
</nav>
